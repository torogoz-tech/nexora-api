{
  "DocumentOrigin": {
    "type": "string",
    "enum": [
      "observed_code",
      "declared_business",
      "agent_proposed"
    ],
    "description": "Attributed provenance. observed_code requires a manifest and verified persisted source anchors. Reference existence does not prove the semantic claim made by its external author."
  },
  "RequirementBody": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "problem": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "objective": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "scope": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "source": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "business_actors": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "maxItems": 128,
        "minItems": 1
      },
      "acceptance_criteria": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "maxItems": 128,
        "minItems": 1
      },
      "facts": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "maxItems": 128,
        "default": []
      },
      "assumptions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "maxItems": 128,
        "default": []
      },
      "decisions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "maxItems": 128,
        "default": []
      },
      "open_questions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "maxItems": 128,
        "default": []
      }
    },
    "required": [
      "problem",
      "objective",
      "scope",
      "source",
      "business_actors",
      "acceptance_criteria"
    ]
  },
  "BusinessRuleBody": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "statement": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "conditions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "maxItems": 128,
        "minItems": 1
      },
      "source": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "exceptions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "maxItems": 128,
        "default": []
      },
      "examples": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "maxItems": 128,
        "default": []
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "maxItems": 128,
        "default": []
      }
    },
    "required": [
      "statement",
      "conditions",
      "source"
    ]
  },
  "DecisionBody": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "context": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "decision": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "source": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "alternatives": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "maxItems": 128
      },
      "consequences": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "maxItems": 128
      }
    },
    "required": [
      "context",
      "decision",
      "source",
      "alternatives",
      "consequences"
    ]
  },
  "ArchitectureDeclaration": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "style": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "layers": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "maxItems": 128
      },
      "conventions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "maxItems": 128
      },
      "dependency_restrictions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "maxItems": 128
      }
    },
    "required": [
      "style",
      "layers",
      "conventions",
      "dependency_restrictions"
    ]
  },
  "ProjectDocumentBody": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "source": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "architecture": {
        "anyOf": [
          {
            "$ref": "#/$defs/ArchitectureDeclaration"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "text",
      "source"
    ]
  },
  "DocumentContent": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "requirement"
          },
          "body": {
            "$ref": "#/$defs/RequirementBody"
          }
        },
        "required": [
          "kind",
          "body"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "business_rule"
          },
          "body": {
            "$ref": "#/$defs/BusinessRuleBody"
          }
        },
        "required": [
          "kind",
          "body"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "decision"
          },
          "body": {
            "$ref": "#/$defs/DecisionBody"
          }
        },
        "required": [
          "kind",
          "body"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "document"
          },
          "body": {
            "$ref": "#/$defs/ProjectDocumentBody"
          }
        },
        "required": [
          "kind",
          "body"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "best_practice"
          },
          "body": {
            "$ref": "#/$defs/BestPracticeBody"
          }
        },
        "required": [
          "kind",
          "body"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "technical_debt"
          },
          "body": {
            "$ref": "#/$defs/TechnicalDebtBody"
          }
        },
        "required": [
          "kind",
          "body"
        ]
      }
    ]
  },
  "ProjectDocumentCreate": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "code": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "content": {
        "$ref": "#/$defs/DocumentContent"
      },
      "origin": {
        "$ref": "#/$defs/DocumentOrigin"
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "context_manifest_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "type": "null"
          }
        ]
      },
      "evidence": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "$ref": "#/$defs/DocumentEvidenceInput"
        },
        "default": []
      }
    },
    "required": [
      "code",
      "title",
      "content",
      "origin",
      "reason"
    ]
  },
  "ProjectDocumentRevise": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "expected_revision": {
        "type": "integer",
        "minimum": 1
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "content": {
        "$ref": "#/$defs/DocumentContent"
      },
      "origin": {
        "$ref": "#/$defs/DocumentOrigin"
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "context_manifest_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "type": "null"
          }
        ]
      },
      "evidence": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "$ref": "#/$defs/DocumentEvidenceInput"
        },
        "default": []
      }
    },
    "required": [
      "expected_revision",
      "title",
      "content",
      "origin",
      "reason"
    ]
  },
  "ProjectDocumentChange": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "expected_revision": {
        "type": "integer",
        "minimum": 1
      },
      "archived": {
        "type": "boolean"
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "required": [
      "expected_revision",
      "archived",
      "reason"
    ]
  },
  "DocumentTransitionRequest": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "expected_state_revision": {
        "type": "integer",
        "minimum": 1
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "approval_id": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 128
      }
    },
    "required": [
      "expected_state_revision",
      "reason"
    ]
  },
  "ProjectDocumentPublish": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "expected_revision": {
        "type": "integer",
        "minimum": 1
      },
      "version_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "expected_state_revision": {
        "type": "integer",
        "minimum": 1,
        "default": 1
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "required": [
      "expected_revision",
      "version_id",
      "reason"
    ]
  },
  "DocumentListQuery": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "after": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 50
      },
      "kind": {
        "type": "string",
        "enum": [
          "requirement",
          "business_rule",
          "decision",
          "document",
          "best_practice",
          "technical_debt"
        ]
      },
      "include_archived": {
        "type": "boolean",
        "default": false
      }
    },
    "required": []
  },
  "ProjectContextManifestCreate": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "repository_ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "required": [
      "name",
      "repository_ids",
      "reason"
    ]
  },
  "DocumentEvidenceInput": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "repository_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "Relative persisted source path; traversal and absolute paths are rejected."
      },
      "start_line": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      },
      "line_count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      }
    },
    "required": [
      "repository_id",
      "path",
      "start_line",
      "line_count"
    ]
  },
  "DocumentLinkKind": {
    "type": "string",
    "enum": [
      "references",
      "implements",
      "required_for_transition"
    ],
    "description": "Only explicit required_for_transition links target tasks and feed the server-approved-document guard; max64 active prerequisites per task."
  },
  "DocumentLinkTarget": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "task"
          },
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "kind",
          "task_id",
          "expected_revision"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "document_version"
          },
          "document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "kind",
          "document_id",
          "version_id",
          "expected_revision"
        ]
      }
    ]
  },
  "DocumentLinkCreate": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "expected_document_revision": {
        "type": "integer",
        "minimum": 1
      },
      "version_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "target": {
        "$ref": "#/$defs/DocumentLinkTarget"
      },
      "kind": {
        "$ref": "#/$defs/DocumentLinkKind"
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "required": [
      "expected_document_revision",
      "version_id",
      "target",
      "kind",
      "reason"
    ]
  },
  "DocumentLinkRemove": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "expected_document_revision": {
        "type": "integer",
        "minimum": 1
      },
      "expected_target_revision": {
        "type": "integer",
        "minimum": 1
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "required": [
      "expected_document_revision",
      "expected_target_revision",
      "reason"
    ]
  },
  "ContextDocumentReference": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "document_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "version_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "required": [
      "document_id",
      "version_id"
    ]
  },
  "ProjectContextPackageCreate": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "context_manifest_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "type": "null"
          }
        ]
      },
      "document_versions": {
        "type": "array",
        "maxItems": 32,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/ContextDocumentReference"
        },
        "default": []
      },
      "task_ids": {
        "type": "array",
        "maxItems": 32,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "default": []
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "required": [
      "name",
      "reason"
    ]
  },
  "BestPracticeBody": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "guideline": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "rationale": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "source": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "examples": {
        "type": "array",
        "maxItems": 128,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "default": []
      }
    },
    "required": [
      "guideline",
      "rationale",
      "source"
    ]
  },
  "TechnicalDebtBody": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "problem": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "impact": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "remediation": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "source": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      }
    },
    "required": [
      "problem",
      "impact",
      "remediation",
      "source"
    ]
  }
