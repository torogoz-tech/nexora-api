  {
    "name": "nexora_task_subtask_create",
    "description": "Create a pending subtask with its own responsibility and task-selected entry workflow. Decomposition children integrate into the parent branch and finish their current stage. Corrective children require the exact tested repository and full commit SHA, deliver the correction to the parent environment without moving the parent, and integrate back into develop.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_id",
        "subtask"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "subtask": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_revision",
            "definition"
          ],
          "properties": {
            "expected_revision": {
              "type": "integer",
              "minimum": 1
            },
            "definition": {
              "$ref": "#/$defs/TaskCreate"
            },
            "work_kind": {
              "type": "string",
              "enum": [
                "decomposition",
                "corrective"
              ],
              "default": "decomposition"
            },
            "tested_repository_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 128
            },
            "tested_commit_sha": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
            }
          }
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
