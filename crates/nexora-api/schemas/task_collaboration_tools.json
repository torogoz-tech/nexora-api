  {
    "name": "nexora_task_knowledge_link",
    "description": "Link an authorized project task to an existing feature or exact requirement version in the same project. Does not create features, approve requirements or change the approved requirement-feature map. Requires task write and document read; requirement links additionally require document write. Use current task and target revisions. Projectless tasks cannot link project knowledge. For task blockers use nexora_task_dependency_create; use dependency.source_task_id as the dependent and dependency.target_task_id as the prerequisite with kind=depends_on.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_id",
        "link"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "link": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target_id",
            "expected_revision",
            "expected_target_revision",
            "reason"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "feature",
                "requirement"
              ]
            },
            "target_id": {
              "type": "string"
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 1
            },
            "expected_target_revision": {
              "type": "integer",
              "minimum": 1
            },
            "version_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "nexora_task_project_change",
    "description": "Explicitly transfer a task to an authorized project or projectless team pool. Requires live read/write authority in both scopes and modification authority. Preserves task identity, evidence, comments, history and independent execution workflow. Refuses project-anchored relationships, backlogs and legacy project workflows; never silently detaches them. Assignee and type must be valid in the destination. Use expected revision and idempotency request ID.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
