  {
    "name": "nexora_release_create",
    "description": "Prepare and inspect an explicit selected-task release with immutable task revisions and repository commit pins. Selection never merges branches or deploys. Technical leads/managers may prepare; only internally verified production provider outcomes can publish and complete the selected tasks. No public deployed assertion is accepted.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tasks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "task_id",
                  "expected_revision"
                ]
              }
            },
            "repositories": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "repository_id": {
                    "type": "string"
                  },
                  "head_sha": {
                    "type": "string",
                    "description": "Optional candidate hint; never treated as composition proof. The server computes the release head from explicit task commits."
                  }
                },
                "required": [
                  "repository_id"
                ]
              }
            },
            "version": {
              "type": "string"
            },
            "branch_name": {
              "type": "string",
              "description": "Explicit release/... branch for these selected changes."
            }
          },
          "required": [
            "tasks",
            "repositories",
            "version",
            "branch_name"
          ]
        }
      },
      "required": [
        "project_id",
        "request_id",
        "input"
      ]
    }
  },
