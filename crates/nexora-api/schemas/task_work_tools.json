  {
    "name": "nexora_repository_development_policy_get",
    "description": "Read authorized repository branch policy. Defaults to develop and feature.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "repository_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "nexora_repository_development_policy_set",
    "description": "Change branch policy with optimistic revision. Requires repositories:write and workflows:write.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository_id",
        "request_id",
        "policy"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "repository_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_revision",
            "base_branch",
            "branch_prefix"
          ],
          "properties": {
            "expected_revision": {
              "type": "integer",
              "minimum": 0
            },
            "base_branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "branch_prefix": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "nexora_task_work_prepare",
    "description": "Prepare an own-actor working_branch_reported session. Governed implementation tasks reuse the provider-created branch and exact base returned by Take(repository_ids); they never reserve a new local placeholder branch. Use Git to fetch/check out that remote branch and push code, then report the exact unchanged base SHA and pushed head through nexora_task_work_report. Legacy task sessions preserve their historical naming contract.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "task_id",
        "request_id",
        "preparation"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "preparation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transition_id",
            "parameters",
            "repository_ids"
          ],
          "properties": {
            "transition_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "expected_revision"
              ],
              "properties": {
                "expected_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "resolution": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "clear_resolution": {
                  "type": "boolean"
                },
                "approval_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "repository_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "nexora_task_work_get",
    "description": "Read own work session and reconcile uncertain responses.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "task_id",
        "session_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "nexora_task_work_report",
    "description": "Persist immutable Git metadata reported by this API-key actor for its prepared session. Agent executes Git on the developer machine. Does not run Git, inspect local files, verify provider state, or change task state. Provenance is agent_reported; transition separately through nexora_task_transition.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "task_id",
        "session_id",
        "request_id",
        "report"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "branches"
          ],
          "properties": {
            "branches": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repository_id",
                  "branch_name",
                  "base_sha",
                  "head_sha"
                ],
                "properties": {
                  "repository_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "branch_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 180
                  },
                  "base_sha": {
                    "type": "string",
                    "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
                  },
                  "head_sha": {
                    "type": "string",
                    "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
]
