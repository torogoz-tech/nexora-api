          "null"
        ],
        "minLength": 1,
        "maxLength": 128
      }
    },
    "required": [
      "title",
      "type_code",
      "origin"
    ],
    "description": "A backlog or explicit published workflow version is required. New tasks derive their state from the selected graph. No implicit workflow or role default."
  },
