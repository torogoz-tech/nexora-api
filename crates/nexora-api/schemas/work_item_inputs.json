{
  "TaskPriority": {
    "type": "string",
    "enum": [
      "low",
      "medium",
      "high",
      "critical"
    ]
  },
  "TaskTypeCreate": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "code": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "description": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          {
            "type": "null"
          }
        ]
      },
      "color": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          {
            "type": "null"
          }
        ],
        "description": "Optional RGB display color. Omit on change to preserve; null clears to client default."
      },
      "purpose": {
        "type": "string",
        "enum": [
          "product_design",
          "implementation",
          "general"
        ]
      }
    },
    "required": [
      "code",
      "name"
    ]
  },
