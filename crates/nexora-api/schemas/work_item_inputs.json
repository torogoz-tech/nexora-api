        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "description": "Informational acceptance criteria in Markdown; no completion guard. On changes omit to preserve, [] to clear."
      },
      "entry_workflow_id": {
        "type": [
          "string",
          "null"
