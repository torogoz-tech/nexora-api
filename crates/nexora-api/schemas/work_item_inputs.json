            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          {
            "type": "null"
          }
        ]
      },
      "branches": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository_id",
            "branch_name",
            "expected_head_sha"
          ],
          "properties": {
            "repository_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "branch_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "expected_head_sha": {
              "type": "string",
              "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
            }
          }
        },
        "maxItems": 8
      },
      "release_id": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "maxLength": 128,
        "description": "Selected authorized release for a publish_release final pipeline; included in human approval and request fingerprint."
      },
      "release_revision": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1,
        "description": "Expected revision of the selected release."
      }
    },
    "required": [
      "expected_revision"
    ]
  },
