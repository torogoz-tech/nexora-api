[
  {
    "name": "nexora_evidence_upload",
    "description": "Upload actor-provided screenshot, test measurements or text evidence. Immutable PostgreSQL storage, SHA256 and current project/repository authority; optional document version and snapshot are validated. An upload does not certify visual correctness or author identity.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository_id",
            "name",
            "media_type",
            "data_base64",
            "phase",
            "description"
          ],
          "properties": {
            "repository_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "snapshot": {
              "type": [
                "string",
                "null"
              ]
            },
            "document_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "document_version_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "media_type": {
              "enum": [
                "image/png",
                "image/jpeg",
                "image/webp",
                "text/plain",
                "text/markdown",
                "application/json"
              ]
            },
            "data_base64": {
              "type": "string",
              "minLength": 4,
              "maxLength": 5592408
            },
            "phase": {
              "enum": [
                "before",
                "after",
                "supporting"
              ]
            },
            "description": {
              "type": "string",
              "maxLength": 8000
            },
            "provided_metadata": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        }
      },
      "required": [
        "project_id",
        "request_id",
        "evidence"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "nexora_evidence_get",
    "description": "Read authorized evidence metadata, optionally returning the original image as an MCP image block or UTF8 text. Revalidates permission, snapshot/document authority and payload checksum.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "include_content": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "project_id",
        "evidence_id"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "nexora_evidence_list",
    "description": "List metadata of evidence belonging to an authorized repository. Metadata listing does not certify the current source or capture provenance.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "repository_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "project_id",
        "repository_id"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
]
