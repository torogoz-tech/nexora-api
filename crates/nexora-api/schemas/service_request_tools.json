  {
    "name": "nexora_request_list",
    "description": "List service requests. Users see only their own; supervisors see all. Technical task and repository data is never included.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type_id": {
          "type": "string",
          "maxLength": 120
        },
        "search": {
          "type": "string"
        },
        "status": {
          "enum": [
            "new",
            "in_progress",
            "completed"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": []
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
