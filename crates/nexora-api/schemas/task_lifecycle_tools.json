  {
    "name": "nexora_task_move",
    "description": "Move active work to an active backlog in the same project, preserving its pinned workflow and state. Requires task/backlog revisions and tasks:write plus backlogs:write.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "movement": {
          "$ref": "#/$defs/TaskMove"
        }
      },
      "required": [
        "project_id",
        "task_id",
        "request_id",
        "movement"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
