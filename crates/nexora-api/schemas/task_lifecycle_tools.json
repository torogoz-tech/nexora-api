  {
    "name": "nexora_task_take",
    "description": "Explicitly start a pending task. The task selects its entry workflow before Take; the actor must have that workflow assigned. General tasks start without a workflow. Assignment is only a reservation. Do not choose an arbitrary actor workflow in Take. For implementation work select relevant repository_ids; Take creates and verifies provider branches through a durable run. The response includes repository_branches and start_run_id. Retry unchanged parameters to reconcile an uncertain provider outcome; do not create local placeholder branches.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_id",
        "take"
      ],
      "properties": {
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "take": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_revision"
          ],
          "properties": {
            "expected_revision": {
              "type": "integer",
              "minimum": 1
            },
            "workflow_id": {
              "type": "string",
              "minLength": 1,
              "description": "Assigned workflow ID. Required for technical leads, PMO, managers and superadministrators. Developers may omit it to use their sole workflow."
            },
            "repository_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "uniqueItems": true,
              "description": "Explicit repositories for implementation work. Nexora creates provider branches from the selected workflow state base, parent task branch or exact tested corrective revision. Required for governed project implementation when repositories or a state base are configured.",
              "maxItems": 8
            }
          }
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "nexora_task_pool_list",
    "description": "List visible pending, active and completed tasks, including work already taken into a workflow. projectless_tasks_included=false means this credential or project filter excludes tasks without a project: an empty result does not prove the member has no tasks. Respect current credential scope; never broaden it automatically.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "workflow_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "type_code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "search": {
              "type": "string",
              "maxLength": 256
            },
            "after": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "lifecycle": {
              "type": "string",
              "enum": [
                "pending",
                "active",
                "paused",
                "completed"
              ]
            }
          }
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
